# Configuración pública. No colocar secretos ni tokens en estas variables.
# Usar la IP accesible desde Android; localhost apunta al propio dispositivo.
API_BASE_URL=http://localhost:8001/api/v1
WS_URL=http://localhost:8001
MAPS_API_KEY=

# Expo incluye únicamente EXPO_PUBLIC_* en el bundle. Expansión desde los alias.
EXPO_PUBLIC_API_BASE_URL=$API_BASE_URL
EXPO_PUBLIC_WS_URL=$WS_URL
EXPO_PUBLIC_MAPS_API_KEY=$MAPS_API_KEY

# Socket.IO usa /socket.io a través de Nginx, no una conexión WebSocket nativa.
# Android emulado: sustituir localhost por 10.0.2.2 en ambas URLs.
# Dispositivo físico: usar un host accesible por LAN o un túnel HTTPS.
# Compose publica 8001 solo en 127.0.0.1: la IP LAN no basta sin acceso configurado.
# La app NO usa PostgreSQL (5432) ni recibe contraseñas de BD/JWT_SECRET.
